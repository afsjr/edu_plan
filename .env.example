# Modo de teste, sem custo e sem chave:
LLM_PROVIDER=mock

# OpenAI (recomendado para o material real):
# LLM_PROVIDER=openai-compativel
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=

# Groq (alternativa gratuita; TPM de 8K):
# LLM_PROVIDER=openai-compativel
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

# Temperaturas (variação)
# LLM_TEMPERATURE_PLANO=0.4
# LLM_TEMPERATURE_ATIVIDADES=0.8

# Verificador semântico
# VERIFIER_MODEL=gpt-4o-mini

# Imagens em runtime (Cloudflare)
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# IMAGE_MAX=5
# IMAGE_STEPS=4
