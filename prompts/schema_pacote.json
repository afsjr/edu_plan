{
  "$defs": {
    "AtividadeGerada": {
      "properties": {
        "numero": {
          "maximum": 10,
          "minimum": 1,
          "title": "Numero",
          "type": "integer"
        },
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "enunciado": {
          "title": "Enunciado",
          "type": "string"
        },
        "tipo": {
          "enum": [
            "cobrir_palavra",
            "ligar",
            "contar",
            "colorir",
            "completar",
            "desenhar",
            "labirinto",
            "recortar_colar"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "codigo_bncc": {
          "description": "Código existente no plano",
          "title": "Codigo Bncc",
          "type": "string"
        },
        "objetivo_relacionado": {
          "description": "Objetivo do plano, copiado verbatim",
          "title": "Objetivo Relacionado",
          "type": "string"
        },
        "imagem_chave": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chave opcional da biblioteca de ícones",
          "title": "Imagem Chave"
        },
        "imagem_alt": {
          "default": "",
          "description": "Descrição curta, em português, da imagem que ilustraria a atividade",
          "title": "Imagem Alt",
          "type": "string"
        },
        "conteudo": {
          "$ref": "#/$defs/ConteudoAtividade"
        },
        "gabarito": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gabarito"
        }
      },
      "required": [
        "numero",
        "titulo",
        "enunciado",
        "tipo",
        "codigo_bncc",
        "objetivo_relacionado"
      ],
      "title": "AtividadeGerada",
      "type": "object"
    },
    "Avaliacao": {
      "properties": {
        "introducao": {
          "title": "Introducao",
          "type": "string"
        },
        "indicadores": {
          "items": {
            "$ref": "#/$defs/IndicadorAvaliacao"
          },
          "minItems": 2,
          "title": "Indicadores",
          "type": "array"
        }
      },
      "required": [
        "introducao",
        "indicadores"
      ],
      "title": "Avaliacao",
      "type": "object"
    },
    "BrincadeiraCasa": {
      "properties": {
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "organizacao": {
          "default": "",
          "title": "Organizacao",
          "type": "string"
        }
      },
      "required": [
        "titulo",
        "descricao"
      ],
      "title": "BrincadeiraCasa",
      "type": "object"
    },
    "CadernoGerado": {
      "properties": {
        "capa": {
          "$ref": "#/$defs/CapaCaderno"
        },
        "atividades": {
          "items": {
            "$ref": "#/$defs/AtividadeGerada"
          },
          "minItems": 1,
          "title": "Atividades",
          "type": "array"
        },
        "nota_cobertura": {
          "$ref": "#/$defs/NotaCoberturaGerada"
        }
      },
      "required": [
        "capa",
        "atividades"
      ],
      "title": "CadernoGerado",
      "type": "object"
    },
    "CampoExperienciaItem": {
      "properties": {
        "icone": {
          "description": "Um emoji curto, ex.: 👥",
          "title": "Icone",
          "type": "string"
        },
        "nome": {
          "description": "Nome oficial do campo de experiência",
          "title": "Nome",
          "type": "string"
        },
        "justificativa": {
          "title": "Justificativa",
          "type": "string"
        }
      },
      "required": [
        "icone",
        "nome",
        "justificativa"
      ],
      "title": "CampoExperienciaItem",
      "type": "object"
    },
    "CapaCaderno": {
      "properties": {
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "subtitulo": {
          "title": "Subtitulo",
          "type": "string"
        },
        "etapa": {
          "title": "Etapa",
          "type": "string"
        },
        "faixa_etaria": {
          "title": "Faixa Etaria",
          "type": "string"
        },
        "alinhamento_bncc": {
          "title": "Alinhamento Bncc",
          "type": "string"
        },
        "codigo_ancora": {
          "title": "Codigo Ancora",
          "type": "string"
        }
      },
      "required": [
        "titulo",
        "subtitulo",
        "etapa",
        "faixa_etaria",
        "alinhamento_bncc",
        "codigo_ancora"
      ],
      "title": "CapaCaderno",
      "type": "object"
    },
    "ConteudoAtividade": {
      "properties": {
        "texto_para_cobrir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Texto Para Cobrir"
        },
        "linhas_escrita": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linhas Escrita"
        },
        "frases": {
          "items": {
            "type": "string"
          },
          "title": "Frases",
          "type": "array"
        },
        "pares": {
          "items": {
            "$ref": "#/$defs/ParLigar"
          },
          "title": "Pares",
          "type": "array"
        },
        "legenda_cores": {
          "items": {
            "$ref": "#/$defs/ItemLegendaCor"
          },
          "title": "Legenda Cores",
          "type": "array"
        },
        "rotulo_inicio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotulo Inicio"
        },
        "rotulo_fim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotulo Fim"
        },
        "quantidade": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantidade"
        },
        "icone_chave": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chave da biblioteca de ícones, ex.: abacaxi",
          "title": "Icone Chave"
        },
        "sequencia": {
          "items": {
            "type": "string"
          },
          "title": "Sequencia",
          "type": "array"
        },
        "lacunas": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lacunas"
        },
        "itens_recortar": {
          "items": {
            "type": "string"
          },
          "title": "Itens Recortar",
          "type": "array"
        },
        "elementos_extras": {
          "items": {
            "type": "string"
          },
          "title": "Elementos Extras",
          "type": "array"
        }
      },
      "title": "ConteudoAtividade",
      "type": "object"
    },
    "HabilidadeSelecionada": {
      "properties": {
        "codigo": {
          "description": "Código existente na lista de candidatos",
          "title": "Codigo",
          "type": "string"
        }
      },
      "required": [
        "codigo"
      ],
      "title": "HabilidadeSelecionada",
      "type": "object"
    },
    "Identificacao": {
      "properties": {
        "tema": {
          "description": "Descrição oficial do código âncora, verbatim",
          "title": "Tema",
          "type": "string"
        },
        "codigo_ancora": {
          "title": "Codigo Ancora",
          "type": "string"
        },
        "turmas": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Turmas",
          "type": "array"
        },
        "faixa_etaria": {
          "title": "Faixa Etaria",
          "type": "string"
        },
        "tempo_estimado": {
          "title": "Tempo Estimado",
          "type": "string"
        },
        "area_integradora": {
          "description": "Campo oficial do código âncora",
          "title": "Area Integradora",
          "type": "string"
        }
      },
      "required": [
        "tema",
        "codigo_ancora",
        "turmas",
        "faixa_etaria",
        "tempo_estimado",
        "area_integradora"
      ],
      "title": "Identificacao",
      "type": "object"
    },
    "IndicadorAvaliacao": {
      "properties": {
        "criterio": {
          "title": "Criterio",
          "type": "string"
        },
        "pre_1": {
          "title": "Pre 1",
          "type": "string"
        },
        "pre_2": {
          "title": "Pre 2",
          "type": "string"
        }
      },
      "required": [
        "criterio",
        "pre_1",
        "pre_2"
      ],
      "title": "IndicadorAvaliacao",
      "type": "object"
    },
    "ItemLegendaCor": {
      "properties": {
        "numero": {
          "maximum": 20,
          "minimum": 1,
          "title": "Numero",
          "type": "integer"
        },
        "cor": {
          "title": "Cor",
          "type": "string"
        }
      },
      "required": [
        "numero",
        "cor"
      ],
      "title": "ItemLegendaCor",
      "type": "object"
    },
    "Momento": {
      "properties": {
        "ordem": {
          "maximum": 12,
          "minimum": 1,
          "title": "Ordem",
          "type": "integer"
        },
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "minutos": {
          "maximum": 120,
          "minimum": 1,
          "title": "Minutos",
          "type": "integer"
        }
      },
      "required": [
        "ordem",
        "titulo",
        "descricao",
        "minutos"
      ],
      "title": "Momento",
      "type": "object"
    },
    "NotaCoberturaGerada": {
      "properties": {
        "objetivos_nao_trabalhados": {
          "items": {
            "type": "string"
          },
          "title": "Objetivos Nao Trabalhados",
          "type": "array"
        },
        "sugestoes_extras": {
          "items": {
            "type": "string"
          },
          "title": "Sugestoes Extras",
          "type": "array"
        }
      },
      "title": "NotaCoberturaGerada",
      "type": "object"
    },
    "ObjetivosAno": {
      "properties": {
        "ano": {
          "description": "Pré I ou Pré II",
          "title": "Ano",
          "type": "string"
        },
        "itens": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Itens",
          "type": "array"
        }
      },
      "required": [
        "ano",
        "itens"
      ],
      "title": "ObjetivosAno",
      "type": "object"
    },
    "ParLigar": {
      "properties": {
        "palavra": {
          "title": "Palavra",
          "type": "string"
        },
        "letra": {
          "title": "Letra",
          "type": "string"
        },
        "icone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icone"
        }
      },
      "required": [
        "palavra",
        "letra"
      ],
      "title": "ParLigar",
      "type": "object"
    },
    "PlanoGerado": {
      "properties": {
        "titulo": {
          "title": "Titulo",
          "type": "string"
        },
        "subtitulo": {
          "title": "Subtitulo",
          "type": "string"
        },
        "identificacao": {
          "$ref": "#/$defs/Identificacao"
        },
        "campos_experiencia": {
          "items": {
            "$ref": "#/$defs/CampoExperienciaItem"
          },
          "minItems": 1,
          "title": "Campos Experiencia",
          "type": "array"
        },
        "objetivos": {
          "items": {
            "$ref": "#/$defs/ObjetivosAno"
          },
          "minItems": 1,
          "title": "Objetivos",
          "type": "array"
        },
        "habilidades": {
          "items": {
            "$ref": "#/$defs/HabilidadeSelecionada"
          },
          "minItems": 1,
          "title": "Habilidades",
          "type": "array"
        },
        "recursos": {
          "items": {
            "$ref": "#/$defs/Recurso"
          },
          "minItems": 1,
          "title": "Recursos",
          "type": "array"
        },
        "desenvolvimento": {
          "items": {
            "$ref": "#/$defs/Momento"
          },
          "minItems": 1,
          "title": "Desenvolvimento",
          "type": "array"
        },
        "avaliacao": {
          "$ref": "#/$defs/Avaliacao"
        },
        "adaptacoes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Adaptacoes",
          "type": "array"
        },
        "observacoes_professor": {
          "default": "",
          "title": "Observacoes Professor",
          "type": "string"
        },
        "dica": {
          "title": "Dica",
          "type": "string"
        },
        "brincadeira_casa": {
          "$ref": "#/$defs/BrincadeiraCasa"
        }
      },
      "required": [
        "titulo",
        "subtitulo",
        "identificacao",
        "campos_experiencia",
        "objetivos",
        "habilidades",
        "recursos",
        "desenvolvimento",
        "avaliacao",
        "adaptacoes",
        "dica",
        "brincadeira_casa"
      ],
      "title": "PlanoGerado",
      "type": "object"
    },
    "Recurso": {
      "properties": {
        "icone": {
          "description": "Um emoji curto, ex.: 🪪",
          "title": "Icone",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        }
      },
      "required": [
        "icone",
        "descricao"
      ],
      "title": "Recurso",
      "type": "object"
    }
  },
  "properties": {
    "plano": {
      "$ref": "#/$defs/PlanoGerado"
    },
    "caderno": {
      "$ref": "#/$defs/CadernoGerado"
    }
  },
  "required": [
    "plano",
    "caderno"
  ],
  "title": "PacoteGerado",
  "type": "object"
}
