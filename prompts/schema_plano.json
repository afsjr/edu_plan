    "IndicadorAvaliacao": {
      "properties": {
        "criterio": {
          "title": "Criterio",
          "type": "string"
        },
        "pre_1": {
          "title": "Pre 1",
          "type": "string"
        },
        "pre_2": {
          "title": "Pre 2",
